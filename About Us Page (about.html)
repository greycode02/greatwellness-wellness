        <div class="container">
            <div class="section-title">
                <h2>Our Core Principles</h2>
                <p>The foundation of everything we do at GreatWellness Services</p>
            </div>
            
            <div class="mv-grid">
                <div class="mv-card mission">
                    <div class="mv-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Our Mission</h3>
                    <p>To provide person-centered healthcare staffing solutions that enhance quality of life, promote dignity, and support wellness for individuals, families, and healthcare facilities across Ontario.</p>
                </div>
                
                <div class="mv-card vision">
                    <div class="mv-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3>Our Vision</h3>
                    <p>To be Ontario's most trusted partner in healthcare staffing, recognized for our unwavering commitment to person-centered care, inclusivity, and excellence in service delivery.</p>
                </div>
                
                <div class="mv-card values">
                    <div class="mv-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3>Our Values</h3>
                    <ul>
                        <li><strong>Person-Centered Care:</strong> Every individual's preferences and needs come first</li>
                        <li><strong>Compassion:</strong> Heartfelt care in all our interactions</li>
                        <li><strong>Integrity:</strong> Honest, ethical, and transparent service</li>
                        <li><strong>Inclusivity:</strong> Respect for all backgrounds, cultures, and identities</li>
                        <li><strong>Excellence:</strong> Commitment to quality in everything we do</li>
                        <li><strong>Partnership:</strong> Collaborative approach with clients and staff</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

