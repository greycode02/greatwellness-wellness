    <!-- Contact Information -->
    <section class="section-padding">
        <div class="container">
            <div class="contact-grid">
                <div class="contact-info">
                    <h2>Get In Touch</h2>
                    <p>Whether you're a healthcare facility needing staff, a family seeking care for a loved one, or a healthcare professional looking for work, we're here to help.</p>
                    
                    <div class="contact-details">
                        <p><i class="fas fa-map-marker-alt"></i> <strong>Address:</strong> 62 Watt Ave, Welland L3B 1J3 ON</p>
                        <p><i class="fas fa-phone"></i> <strong>Phone:</strong> <a href="tel:6472870676">(647) 287-0676</a></p>
                        <p><i class="fas fa-envelope"></i> <strong>Email:</strong> <a href="mailto:greatwellnessservices@gmail.com">greatwellnessservices@gmail.com</a></p>
                        <p><i class="fas fa-fax"></i> <strong>Fax:</strong> (905) 555-1234</p>
                    </div>
                    
                    <div class="contact-hours">
                        <h4>Business Hours</h4>
                        <p><strong>Monday - Friday:</strong> 8:00 AM - 6:00 PM</p>
                        <p><strong>Saturday:</strong> 9:00 AM - 1:00 PM (Emergency calls only)</p>
                        <p><strong>Sunday:</strong> Closed (Emergency calls only)</p>
                        <p><em>After-hours emergency line available for urgent staffing needs</em></p>
                    </div>
                    
                    <div class="social-icons" style="margin-top: 30px;">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                
                <div class="contact-form">
                    <div class="form-container">
                        <div class="form-header">
                            <h3>Send Us a Message</h3>
                            <p>Fill out the form below and we'll get back to you within 24 hours</p>
                        </div>
                        
                        <form id="contactForm">
                            <div class="form-group">
                                <label for="contactName" class="required">Full Name</label>
                                <input type="text" id="contactName" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="contactEmail" class="required">Email Address</label>
                                <input type="email" id="contactEmail" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="contactPhone" class="required">Phone Number</label>
                                <input type="tel" id="contactPhone" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="contactType">I am contacting you as a:</label>
                                <select id="contactType">
                                    <option value="">Select One</option>
                                    <option value="facility">Healthcare Facility</option>
                                    <option value="family">Family/Individual</option>
                                    <option value="professional">Healthcare Professional</option>
                                    <option value="general">General Inquiry</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="contactSubject">Subject</label>
                                <input type="text" id="contactSubject">
                            </div>
                            
                            <div class="form-group">
                                <label for="contactMessage" class="required">Message</label>
                                <textarea id="contactMessage" required placeholder="Please describe your inquiry or staffing needs..."></textarea>
                            </div>
                            
                            <div class="checkbox-group">
                                <input type="checkbox" id="contactConsent" required>
                                <label for="contactConsent" class="required">I consent to GreatWellness Services collecting and storing my information for contact purposes</label>
                            </div>
                            
                            <div class="form-footer">
                                <p><i class="fas fa-lock"></i> Your information is secure and confidential</p>
                                <button type="submit" class="btn btn-primary">Send Message</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

